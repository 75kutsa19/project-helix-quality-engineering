is 201', function () { pm.response.to.have.status(201); });","pm.test('FHIR response', function () { pm.expect(pm.response.json().resourceType).to.be.a('string'); });","const r = pm.response.json();","if (r.id) pm.environment.set('lastId', r.id);","pm.environment.set('taskId', pm.response.json().id);"]}}]},{"name":"08 Create DiagnosticReport","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/fhir+json"}],"body":{"mode":"raw","raw":"{\"resourceType\":\"DiagnosticReport\",\"status\":\"preliminary\",\"code\":{\"text\":\"Synthetic genomic diagnostic report\"},\"subject\":{\"reference\":\"{{patientRef}}\"},\"basedOn\":[{\"reference\":\"{{serviceRequestRef}}\"}],\"performer\":[{\"reference\":\"{{organizationRef}}\"}],\"result\":[]}"},"url":{"raw":"https://hapi.fhir.org/baseR4/DiagnosticReport","host":["hapi.fhir.org"],"path":["baseR4","DiagnosticReport"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 201', function () { pm.response.to.have.status(201); });","pm.test('FHIR response', function () { pm.expect(pm.response.json().resourceType).to.be.a('string'); });","const r = pm.response.json();","if (r.id) pm.environment.set('lastId', r.id);","pm.environment.set('diagnosticReportId', pm.response.json().id);"]}}]},{"name":"09 Validate Specimen linkage","request":{"method":"GET","header":[{"key":"Content-Type","value":"application/fhir+json"}],"url":{"raw":"https://hapi.fhir.org/baseR4/Specimen/{{specimenId}}","host":["hapi.fhir.org"],"path":["baseR4","Specimen","{{specimenId}}"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', function(){ pm.response.to.have.status(200); });","const r=pm.response.json();","pm.test('Specimen.request contains ServiceRequest reference', function(){ pm.expect(r.request[0].reference).to.eql(pm.environment.get('serviceRequestRef')); });"]}}]},{"name":"10 Validate DiagnosticReport linkage","request":{"method":"GET","header":[{"key":"Content-Type","value":"application/fhir+json"}],"url":{"raw":"https://hapi.fhir.org/baseR4/DiagnosticReport/{{diagnosticReportId}}","host":["hapi.fhir.org"],"path":["baseR4","DiagnosticReport","{{diagnosticReportId}}"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', function(){ pm.response.to.have.status(200); });","const r=pm.response.json();","pm.test('DiagnosticReport references ServiceRequest', function(){ pm.expect(r.basedOn[0].reference).to.eql(pm.environment.get('serviceRequestRef')); });"]}}]},{"name":"11 Create AuditEvent","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/fhir+json"}],"body":{"mode":"raw","raw":"{\"resourceType\":\"AuditEvent\",\"type\":{\"code\":\"rest\",\"display\":\"RESTful Operation\"},\"action\":\"C\",\"recorded\":\"{{$isoTimestamp}}\",\"outcome\":\"0\",\"agent\":[{\"who\":{\"reference\":\"{{practitionerRef}}\"},\"requestor\":true}],\"source\":{\"observer\":{\"reference\":\"{{organizationRef}}\"}},\"entity\":[{\"what\":{\"reference\":\"{{diagnosticReportRef}}\"}},{\"what\":{\"reference\":\"{{patientRef}}\"}}]}"},"url":{"raw":"https://hapi.fhir.org/baseR4/AuditEvent","host":["hapi.fhir.org"],"path":["baseR4","AuditEvent"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 201', function () { pm.response.to.have.status(201); });","pm.test('FHIR response', function () { pm.expect(pm.response.json().resourceType).to.be.a('string'); });","const r = pm.response.json();","if (r.id) pm.environment.set('lastId', r.id);","pm.test('AuditEvent contains Practitioner reference', function(){ pm.expect(r.agent[0].who.reference).to.eql(pm.environment.get('practitionerRef')); });","pm.environment.set('auditEventId', pm.response.json().id);"]}}]},{"name":"12 Negative - Missing Patient reference","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/fhir+json"}],"body":{"mode":"raw","raw":"{\"resourceType\":