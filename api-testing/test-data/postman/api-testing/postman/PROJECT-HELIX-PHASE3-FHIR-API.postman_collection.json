{"info":{"_postman_id":"helix-phase3-fhir-api","name":"Project Helix - Phase 3 FHIR API Testing","description":"Reconstructed Phase 3 Postman workflow for synthetic HAPI FHIR R4 API testing. Includes chained resources, linkage validation, negative reference tests, AuditEvent, and cleanup.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (pm.environment.get('patientId')) pm.environment.set('patientRef','Patient/'+pm.environment.get('patientId'));","if (pm.environment.get('practitionerId')) pm.environment.set('practitionerRef','Practitioner/'+pm.environment.get('practitionerId'));","if (pm.environment.get('organizationId')) pm.environment.set('organizationRef','Organization/'+pm.environment.get('organizationId'));","if (pm.environment.get('consentId')) pm.environment.set('consentRef','Consent/'+pm.environment.get('consentId'));","if (pm.environment.get('serviceRequestId')) pm.environment.set('serviceRequestRef','ServiceRequest/'+pm.environment.get('serviceRequestId'));","if (pm.environment.get('specimenId')) pm.environment.set('specimenRef','Specimen/'+pm.environment.get('specimenId'));","if (pm.environment.get('taskId')) pm.environment.set('taskRef','Task/'+pm.environment.get('taskId'));","if (pm.environment.get('diagnosticReportId')) pm.environment.set('diagnosticReportRef','DiagnosticReport/'+pm.environment.get('diagnosticReportId'));","if (pm.environment.get('auditEventId')) pm.environment.set('auditEventRef','AuditEvent/'+pm.environment.get('auditEventId'));"]}}],"variable":[{"key":"baseUrl","value":"https://hapi.fhir.org/baseR4"}],"item":[{"name":"01 Create Patient","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/fhir+json"}],"body":{"mode":"raw","raw":"{\"resourceType\":\"Patient\",\"identifier\":[{\"system\":\"https://project-helix.test/patient\",\"value\":\"HELIX-TEST-PATIENT-{{$timestamp}}\"}],\"name\":[{\"family\":\