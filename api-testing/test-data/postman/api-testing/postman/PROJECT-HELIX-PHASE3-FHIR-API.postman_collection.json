t/{{auditEventId}}","host":["hapi.fhir.org"],"path":["baseR4","AuditEvent","{{auditEventId}}"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Cleanup status is successful', function(){ pm.expect([200,204]).to.include(pm.response.code); });"]}}]},{"name":"14.02 Cleanup DiagnosticReport","request":{"method":"DELETE","header":[{"key":"Content-Type","value":"application/fhir+json"}],"url":{"raw":"https://hapi.fhir.org/baseR4/DiagnosticReport/{{diagnosticReportId}}","host":["hapi.fhir.org"],"path":["baseR4","DiagnosticReport","{{diagnosticReportId}}"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Cleanup status is successful', function(){ pm.expect([200,204]).to.include(pm.response.code); });"]}}]},{"name":"14.03 Cleanup Task","request":{"method":"DELETE","header":[{"key":"Content-Type","value":"application/fhir+json"}],"url":{"raw":"https://hapi.fhir.org/baseR4/Task/{{taskId}}","host":["hapi.fhir.org"],"path":["baseR4","Task","{{taskId}}"]}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Cleanup status is successful', function(){ pm.expect([200,204]).to.include(pm.response.code); });"]}}]}]}
