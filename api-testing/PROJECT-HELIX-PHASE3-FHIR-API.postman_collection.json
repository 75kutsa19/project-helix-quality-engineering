            "ServiceRequest"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"resourceType\": \"ServiceRequest\",\n  \"status\": \"active\",\n  \"intent\": \"order\",\n  \"subject\": {\n    \"reference\": \"Patient/{{patientId}}\"\n  },\n  \"requester\": {\n    \"reference\": \"Practitioner/{{practitionerId}}\"\n  },\n  \"code\": {\n    \"text\": \"Synthetic genomic test\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', function(){pm.expect(pm.response.code).to.eql(201);});",
              "pm.test('resourceType is ServiceRequest', function(){pm.expect(pm.response.json().resourceType).to.eql('ServiceRequest');});",
              "pm.test('Patient reference is correct', function(){pm.expect(pm.response.json().subject.reference).to.eql('Patient/'+pm.collectionVariables.get('patientId'));});",
              "pm.test('ServiceRequest ID captured', function(){pm.expect(pm.response.json().id).to.exist; pm.collectionVariables.set('serviceRequestId',pm.response.json().id);});"
            ]
          }
        }
      ]
