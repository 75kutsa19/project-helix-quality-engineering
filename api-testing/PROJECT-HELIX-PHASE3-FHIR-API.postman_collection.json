    {
      "name": "04 Create Consent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/fhir+json"
          }
        ],
        "url": {
          "raw": "https://hapi.fhir.org/baseR4/Consent",
          "host": [
            "hapi.fhir.org"
          ],
          "path": [
            "Consent"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"resourceType\": \"Consent\",\n  \"status\": \"active\",\n  \"scope\": {\n    \"coding\": [\n      {\n        \"system\": \"http://terminology.hl7.org/CodeSystem/consentscope\",\n        \"code\": \"patient-privacy\"\n      }\n    ]\n  },\n  \"patient\": {\n    \"reference\": \"Patient/{{patientId}}\"\n  },\n  \"performer\": [\n    {\n      \"reference\": \"Practitioner/{{practitionerId}}\"\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', function(){pm.expect(pm.response.code).to.eql(201);});",
              "pm.test('resourceType is Consent', function(){pm.expect(pm.response.json().resourceType).to.eql('Consent');});",
              "pm.test('Consent patient reference is present', function(){pm.expect(pm.response.json().patient.reference).to.eql('Patient/'+pm.collectionVariables.get('patientId'));});",
              "pm.test('Consent ID captured', function(){pm.expect(pm.response.json().id).to.exist; pm.collectionVariables.set('consentId',pm.response.json().id);});"
            ]
          }
        }
