        "body": {
          "mode": "raw",
          "raw": "{\n  \"resourceType\": \"Specimen\",\n  \"status\": \"available\",\n  \"subject\": {\n    \"reference\": \"Patient/{{patientId}}\"\n  },\n  \"request\": [\n    {\n      \"reference\": \"ServiceRequest/{{serviceRequestId}}\"\n    }\n  ],\n  \"type\": {\n    \"text\": \"Synthetic specimen\"\n  }\n}"
        }
      },
      "event": [
