  "item": [
    {
      "name": "01 Create Patient",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/fhir+json"
          }
        ],
        "url": {
          "raw": "https://hapi.fhir.org/baseR4/Patient",
          "host": [
            "hapi.fhir.org"
          ],
          "path": [
            "Patient"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"resourceType\": \"Patient\",\n  \"identifier\": [\n    {\n      \"system\": \"https://project-helix.example/test\",\n      \"value\": \"HELIX-TEST-PATIENT-{{testSuffix}}\"\n    }\n  ],\n  \"name\": [\n    {\n      \"family\": \"Helix\",\n      \"given\": [\n        \"Synthetic\",\n        \"Patient\"\n      ]\n    }\n  ],\n  \"gender\": \"unknown\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": "pm.variables.set('testSuffix', Date.now().toString());"
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', function(){pm.expect(pm.response.code).to.eql(201);});",
              "pm.test('resourceType is Patient', function(){pm.expect(pm.response.json().resourceType).to.eql('Patient');});",
              "pm.test('Patient ID captured', function(){pm.expect(pm.response.json().id).to.exist; pm.collectionVariables.set('patientId',pm.response.json().id);});"
            ]
          }
        }
      ]
    },
