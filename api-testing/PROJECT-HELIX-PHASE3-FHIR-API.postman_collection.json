              "pm.test('resourceType is Specimen', function(){pm.expect(pm.response.json().resourceType).to.eql('Specimen');});",
              "pm.test('ServiceRequest linkage is present', function(){pm.expect(pm.response.json().request[0].reference).to.eql('ServiceRequest/'+pm.collectionVariables.get('serviceRequestId'));});",
              "pm.test('Specimen ID captured', function(){pm.expect(pm.response.json().id).to.exist; pm.collectionVariables.set('specimenId',pm.response.json().id);});"
            ]
          }
